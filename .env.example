# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > App da Web).
# Na Netlify, cadastre as mesmas variáveis em Site configuration > Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endereço público do site, sem barra no fim. O valor de produção está em .env.production.
VITE_SITE_URL=
